<Project>
  <PropertyGroup>
    <!-- Target Framework and Language Defaults -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Roslyn Code Analysis & Linting Defaults -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    
    <!-- Suppress CA1707 (underscores in test names) and CA1305 (locale string formatting) for benchmarks/tests -->
    <NoWarn>$(NoWarn);CA1707;CA1305</NoWarn>

    <!-- Package Metadata -->
    <Authors>Bifteki Crew</Authors>
    <Company>Bifteki Crew</Company>
    <Copyright>Copyright (c) 2026 Bifteki Crew</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/bifteki-crew/JsonRepair.NET</RepositoryUrl>

    <!-- SourceLink: embed repository info for debugging into all projects -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
